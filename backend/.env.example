# ============================================
# NewsDataHub API Configuration
# ============================================

# Your NewsDataHub API key
# Get your free API key at: https://newsdatahub.com
# Required when ENABLE_DEMO_MODE=false
NEWSDATAHUB_API_KEY=your_api_key_here

# ============================================
# Server Configuration
# ============================================

# Port the backend server will listen on
# Default: 3001
PORT=3001

# Node environment (development, production, test)
# Default: development
NODE_ENV=development

# Allowed CORS origins (comma-separated)
# For development, use: http://localhost:5173
# For production with Docker, use: http://localhost
# For custom domains, add them here: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# ============================================
# Demo Mode
# ============================================

# Enable demo mode to use pre-cached sample data instead of live API
# Set to 'true' to run without an API key (uses local demo data)
# Set to 'false' to use real NewsDataHub API (requires NEWSDATAHUB_API_KEY)
# Default: true
ENABLE_DEMO_MODE=true
